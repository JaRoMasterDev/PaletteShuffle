{
  "schemaVersion": 1,
  "id": "blockshuffle",
  "version": "${version}",
  "name": "BlockShuffle",
  "description": "Places your blocks in a random mix. Press K to toggle shuffle mode: after every block you place, your hotbar switches to a random block. Press J to choose which hotbar slots take part and how likely each one is.",
  "authors": [
    "Jarne Rolf"
  ],
  "contact": {
    "homepage": "https://jarne-rolf.de"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/blockshuffle/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "org.jarnerolf.blockshuffle.client.BlockshuffleDataGenerator"
    ],
    "client": [
      "org.jarnerolf.blockshuffle.client.BlockshuffleClient"
    ],
    "main": [
      "org.jarnerolf.blockshuffle.Blockshuffle"
    ]
  },
  "mixins": [
    "blockshuffle.mixins.json",
    {
      "config": "blockshuffle.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
