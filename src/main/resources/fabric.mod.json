{
  "schemaVersion": 1,
  "id": "paletteshuffle",
  "version": "${version}",
  "name": "Palette Shuffle",
  "description": "Places your blocks in a random mix. Press K to toggle shuffle mode: after every block you place, your hotbar switches to a random block. Press J to choose which hotbar slots take part and how likely each one is.",
  "authors": [
    "JaRoMaster"
  ],
  "contact": {
    "homepage": "https://github.com/JaRoMasterDev/PaletteShuffle",
    "sources": "https://github.com/JaRoMasterDev/PaletteShuffle",
    "issues": "https://github.com/JaRoMasterDev/PaletteShuffle/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/paletteshuffle/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "org.jarnerolf.paletteshuffle.client.PaletteShuffleDataGenerator"
    ],
    "client": [
      "org.jarnerolf.paletteshuffle.client.PaletteShuffleClient"
    ],
    "main": [
      "org.jarnerolf.paletteshuffle.PaletteShuffle"
    ],
    "modmenu": [
      "org.jarnerolf.paletteshuffle.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "paletteshuffle.mixins.json",
    {
      "config": "paletteshuffle.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
